<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://digmi.eu/lab/clock-probe" version="0.1.0" height="1920" width="1080" viewmodes="fullscreen">
    <!--
      Lab probe for the panel clock. NOT the product: its own application and
      package id, so it installs beside DigmiMarketing and can never replace it.

      Bench 2026-11-11: the menu clock read 2014 while the widget's JS clock
      read 2026, so the time guard (src/js/timeguard.js) never had a reason to
      act. This probe shows the clocks side by side and runs setNTP on a key
      press, printing the exception type, so the answers are measured rather
      than guessed.
    -->
    <tizen:application id="DgmiLab002.ClockProbe" package="DgmiLab002" required_version="5.0"/>
    <access origin="*" subdomains="true"></access>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>DigmiClockProbe</name>
    <author href="https://digmi.se">Digmi Group AB</author>
    <!-- Same two Partner-level privileges src/config.xml declares for the guard. -->
    <tizen:privilege name="http://developer.samsung.com/privilege/devicetimer"/>
    <tizen:privilege name="http://tizen.org/privilege/networkbearerselection"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="portrait" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
