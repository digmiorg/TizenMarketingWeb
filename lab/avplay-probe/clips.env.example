# Copy to clips.env (gitignored) and fill in the real values.
#
# This repo is PUBLIC, and these values point at real customer media.
# Neither the bucket nor the object names belong in git. Treat a name that
# lands in a commit as disclosed: rotate it, do not merely delete the file —
# the history keeps it, and so does anyone who cloned in between.
#
# Only the UNIFORM clips are needed: they share resolution and frame rate, so
# a difference between two runs is the playlist, not the format spread. The
# old MIXED set (m1-m3) was dropped once CAMPAIGN replaced it — it was tens of
# megabytes of payload in every .wgt that no playlist referenced any more.
# BASE is the full URL prefix the clips hang off, no trailing slash.
BASE="https://<host>/<path>"

# Rows are: <local name the probe plays> <remote object name>. The three
# u-clips are required — js/main.js plays them by these exact local names.
declare -a CLIPS=(
  "u1.mp4 <remote-name>.mp4"  # 1080x1920 @25
  "u2.mp4 <remote-name>.mp4"  # 1080x1920 @25
  "u3.mp4 <remote-name>.mp4"  # 1080x1920 @25
)
